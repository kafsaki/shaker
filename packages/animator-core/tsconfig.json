{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "paths": {
      "@shaker/recipe-ir": [
        "../recipe-ir/src/index.ts"
      ],
      "@shaker/seed": [
        "../seed/src/index.ts"
      ],
      "@shaker/visual-assets": [
        "../visual-assets/src/index.ts"
      ],
      "@shaker/recipe-ir/core": [
        "../recipe-ir/src/core.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
