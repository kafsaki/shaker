{
  "name": "@shaker/prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "动画引擎验证装置。不是产品代码。",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --format=esm --target=es2022 --outfile=dist/main.js --sourcemap",
    "watch": "esbuild src/main.ts --bundle --format=esm --target=es2022 --outfile=dist/main.js --sourcemap --watch",
    "serve": "node ../scripts/serve.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@shaker/recipe-ir": "workspace:*",
    "@shaker/animator-core": "workspace:*",
    "@shaker/animator-web": "workspace:*",
    "@shaker/seed": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.7.2"
  }
}
