# 部署配置模板：复制成同目录的 .env 后改掉所有 change-me。
#
#   cp deploy/.env.example deploy/.env
#   docker compose -f deploy/docker-compose.yml --env-file deploy/.env up -d --build
#
# .env 已被 .gitignore 排除，不会进仓库。

# 对外域名。Caddy 会为它自动申请 Let's Encrypt 证书；
# 填 localhost 时用 Caddy 内部 CA（浏览器会提示证书不受信任，仅供本机试跑）。
SHAKER_DOMAIN=localhost

# Postgres 密码（容器内部使用，不对公网暴露端口）
POSTGRES_PASSWORD=change-me-postgres

# MinIO 凭据。既是对象存储的管理员账号，也是 API 的 S3 访问密钥。
MINIO_ROOT_USER=shaker
MINIO_ROOT_PASSWORD=change-me-minio

# JWT 签名密钥。必须改成随机长串：openssl rand -base64 48
SHAKER_JWT_SECRET=change-me-jwt

# 百科管理员账号（逗号分隔 handle，ADR-027）
SHAKER_ADMIN_HANDLES=

# 酒保助手（ADR-028）：OpenAI 兼容接口。密钥留空即关闭助手，前端不显示入口。
# 备用密钥在主密钥 401/402/403/429/5xx 时自动接替。
SHAKER_LLM_BASE_URL=https://api.deepseek.com
SHAKER_LLM_MODEL=deepseek-flash
SHAKER_LLM_API_KEY=
SHAKER_LLM_API_KEY_FALLBACK=
SHAKER_LLM_EFFORT=low

# 日志时间戳时区
TZ=Asia/Shanghai
