{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "paths": {
      "@shaker/recipe-ir": [
        "../packages/recipe-ir/src/index.ts"
      ],
      "@shaker/animator-core": [
        "../packages/animator-core/src/index.ts"
      ],
      "@shaker/animator-web": [
        "../packages/animator-web/src/render.ts"
      ],
      "@shaker/seed": [
        "../packages/seed/src/index.ts"
      ],
      "@shaker/recipe-ir/core": [
        "../packages/recipe-ir/src/core.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
